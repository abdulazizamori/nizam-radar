{
  "$defs": {
    "Applicability": {
      "enum": [
        "applies",
        "likely_applies",
        "does_not_apply",
        "needs_review"
      ],
      "title": "Applicability",
      "type": "string"
    },
    "Bilingual": {
      "additionalProperties": false,
      "properties": {
        "ar": {
          "title": "Ar",
          "type": "string"
        },
        "en": {
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "ar",
        "en"
      ],
      "title": "Bilingual",
      "type": "object"
    },
    "ChecklistItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "text_ar": {
          "title": "Text Ar",
          "type": "string"
        },
        "text_en": {
          "title": "Text En",
          "type": "string"
        },
        "due_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due Date"
        },
        "done": {
          "default": false,
          "title": "Done",
          "type": "boolean"
        }
      },
      "required": [
        "item_id",
        "text_ar",
        "text_en"
      ],
      "title": "ChecklistItem",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "article_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Article Ref"
        },
        "quote": {
          "maxLength": 300,
          "title": "Quote",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "quote",
        "source_url"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "DeadlineType": {
      "enum": [
        "fixed_date",
        "relative",
        "none"
      ],
      "title": "DeadlineType",
      "type": "string"
    },
    "FilterResult": {
      "additionalProperties": false,
      "properties": {
        "relevant": {
          "title": "Relevant",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "relevant",
        "reason"
      ],
      "title": "FilterResult",
      "type": "object"
    },
    "ModelsUsed": {
      "additionalProperties": false,
      "properties": {
        "filter": {
          "title": "Filter",
          "type": "string"
        },
        "reasoning": {
          "title": "Reasoning",
          "type": "string"
        },
        "writer": {
          "title": "Writer",
          "type": "string"
        }
      },
      "required": [
        "filter",
        "reasoning",
        "writer"
      ],
      "title": "ModelsUsed",
      "type": "object"
    },
    "Obligation": {
      "additionalProperties": false,
      "properties": {
        "obligation_id": {
          "title": "Obligation Id",
          "type": "string"
        },
        "description": {
          "$ref": "#/$defs/Bilingual"
        },
        "deadline": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline"
        },
        "deadline_type": {
          "$ref": "#/$defs/DeadlineType",
          "default": "none"
        },
        "deadline_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline Text"
        },
        "penalty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Penalty"
        },
        "citation": {
          "$ref": "#/$defs/Citation"
        }
      },
      "required": [
        "obligation_id",
        "description",
        "citation"
      ],
      "title": "Obligation",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "urgent",
        "important",
        "info"
      ],
      "title": "Priority",
      "type": "string"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "tokens_in": {
          "default": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "title": "Tokens Out",
          "type": "integer"
        },
        "cost_usd": {
          "default": 0.0,
          "title": "Cost Usd",
          "type": "number"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "pattern": "^ana_[a-z0-9_]+$",
      "title": "Analysis Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "regulation_id": {
      "title": "Regulation Id",
      "type": "string"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "filter": {
      "$ref": "#/$defs/FilterResult"
    },
    "applicability": {
      "$ref": "#/$defs/Applicability"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "reasoning_summary": {
      "$ref": "#/$defs/Bilingual"
    },
    "obligations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Obligation"
      },
      "title": "Obligations",
      "type": "array"
    },
    "next_deadline": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Deadline"
    },
    "priority": {
      "$ref": "#/$defs/Priority"
    },
    "summary": {
      "$ref": "#/$defs/Bilingual"
    },
    "checklist": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ChecklistItem"
      },
      "title": "Checklist",
      "type": "array"
    },
    "models_used": {
      "$ref": "#/$defs/ModelsUsed"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "notified_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notified At"
    }
  },
  "required": [
    "analysis_id",
    "regulation_id",
    "profile_id",
    "created_at",
    "filter",
    "applicability",
    "confidence",
    "reasoning_summary",
    "priority",
    "summary",
    "models_used",
    "usage"
  ],
  "title": "AnalysisResult",
  "type": "object"
}
